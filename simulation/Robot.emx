      rectangle 136 640 184 672 color 0 fill 16777215;
      text 'filedata' 158.4 656;
    end;
    implementation eq
// 20-sim User Editor
// DataFromFile.dll
/* CONFIGURATION
DataVariable true "Time" Time 1 0
DataVariable true "Cond" Cond 1 0
DataVariable true "X" X 1 0
DataVariable true "Y" Y 1 0
DataVariable true "Z" Z 1 0
DataVariable true "Roll" Roll 1 0
DataVariable true "Pitch" Pitch 1 0
DataVariable true "Yaw" Yaw 1 0
SelectionVariable time 1
OffsetFirstDataPoint false
FindRowValueInColumn 0
StopSimulationAtEOF false
END CONFIGURATION */
parameters
	string fileName = 'C:\Users\cenni\Desktop\trajectory.csv';
variables
	real hidden dataFileId;
	real row_values[8];
	real hidden dll_read_inputs[3];

initialequations
	dataFileId = dll('DataFromFile.dll', 'InitializeDataFile', fileName);
code

	dll_read_inputs = [dataFileId; time; 0];
	row_values = dll('DataFromFile.dll', 'GetRowValues', dll_read_inputs);
	Time = row_values[1];
	Cond = row_values[2];
	X = row_values[3];
	Y = row_values[4];
	Z = row_values[5];
	Roll = row_values[6];
	Pitch = row_values[7];
	Yaw = row_values[8];
implementation_end;
