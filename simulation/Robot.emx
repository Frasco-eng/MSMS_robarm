    description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\MSe.emx</LibraryPath><TimeStamp>2011-11-29 16:12:33</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
    type MSe
     ports
      power out gravity [6,1];
      signal in T_next [4,4];
      signal boolean in condition;
     restrictions
      causality fixed out gravity;
     parameters
      real m_load = 1.0;
    end;
    icon bg ellipse left
     figures
      text 'MSe' 1384 152 color 0 18 bold;
    end;
    implementation eq
parameters
	real effort[3,1] = [0; 0; -9.81];
variables
	real flow[6,1];
equations
	
	if condition then
		gravity.e[1:3] = transpose(T_next[1:3, 1:3]) * effort * m_load;
		gravity.e[4:6] = [0; 0; 0];
	else
		gravity.e = [0; 0; 0; 0; 0; 0];
	end;
	
	flow = gravity.f;implementation_end;
