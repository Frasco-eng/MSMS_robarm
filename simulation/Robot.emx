      FlowSensor1 288 311.9
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\FlowSensor.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:50:53</TimeStamp>
</Description>
</Information>';
       knot FlowSensor
        ports
         power knot in p1 [6,1];
         power knot out p2 [6,1];
         signal knot out flow [6,1];
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse
        figures
         ellipse 281.1 304.8 294.9 319.1 color 0 fill 16777215;
         text 'f' 288 311.2 color 0;
       end;
       implementation eq
equations
	p2.f = p1.f;
	p1.e = p2.e;
	flow = p1.f;
implementation_end;
      Integrate 848 296
       description '<Information>
 <Description>
    <Version>4.3</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Signal\Block Diagram\Integrate.emx</LibraryPath>
  <TimeStamp>2013-3-8 14:47:42</TimeStamp>
</Description>
</Information>';
       type Integrate
        ports
         signal in input [6,1];
         signal out output [6,1];
       end;
       icon bg bottom
        figures
         rectangle 832 280 864 312 color 0 fill 15132390;
         text '∫' 848 296.3 color 16711680 'Lucida Sans' 21 italic;
       end;
       implementation eq
equations
    output = int(input);implementation_end;
      ipp_com 352 280
       description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\MTF.emx</LibraryPath><TimeStamp>2011-11-29 16:15:31</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type MTF
        ports
         power out wrench_out [6,1];
         power in wrench_com [6,1];
        restrictions
         causality constraint not_equal wrench_out wrench_com;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 352 280 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup r_gp[3,1];

equations
	wrench_out.f[1:3] = wrench_com.f[1:3] + cross(r_gp, wrench_com.f[4:6]);
	wrench_out.f[4:6] = wrench_com.f[4:6];
	wrench_com.e[4:6] = wrench_out.e[4:6] - cross(r_gp, wrench_out.e[1:3]);
	wrench_com.e[1:3] = wrench_out.e[1:3];
implementation_end;
      i_com 352 120
       description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\MTF.emx</LibraryPath><TimeStamp>2011-11-29 16:15:31</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type MTF
        ports
         power in wrench_in [6,1];
         power out wrench_com [6,1];
        restrictions
         causality constraint not_equal wrench_in wrench_com;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 352 120 color 0 18 bold;
       end;
       implementation eq
parameters
	real global r_gp[3,1];

equations
	wrench_in.f[1:3] = wrench_com.f[1:3] + cross(r_gp, wrench_com.f[4:6]);
	wrench_in.f[4:6] = wrench_com.f[4:6];
	wrench_com.e[4:6] = wrench_in.e[4:6] - cross(r_gp, wrench_in.e[1:3]);
	wrench_com.e[1:3] = wrench_in.e[1:3];
implementation_end;
      MSe 512 104
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MSe.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:12:33</TimeStamp>
</Description>
</Information>';
       type MSe
        ports
         power out gravity [6,1];
         signal in T_next [4,4];
        restrictions
         causality fixed out gravity;
       end;
       icon bg ellipse bottom
        figures
         text 'MSe' 512 104 color 0 18 bold;
       end;
       implementation eq
parameters
	real global m;
	real effort[3,1] = [0; 0; -9.81];
variables
	real flow[6,1];
equations
	gravity.e[1:3] = transpose(T_next[1:3, 1:3]) * effort * m;
	gravity.e[4:6] = [0; 0; 0];
	flow = gravity.f;implementation_end;
      plug wrench_ipp 232 344;
      plug T_next 512 40;
      plug wrench_i 240 72;
      OneJunction 512 176
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\OneJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:17:51</TimeStamp>
</Description>
</Information>';
       knot OneJunction
        ports
         power knot duplicatable none p [6,1];
         signal knot out flow [6,1];
        restrictions
         causality constraint one_out p;
       end;
       icon bg ellipse
        figures
         text '1' 512 176 color 0 18 bold;
       end;
       implementation eq
equations
	sum (direct (p.e)) = 0;
	equal (collect (p.f));
	flow = first (p.f);
implementation_end;
      Rot 720 312
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in T [4,4];
         signal out output [6,1];
         signal in twist [6,1];
         signal in rpy [3,1];
       end;
       implementation eq

equations
	output[1:3] = T[1:3, 1:3] * twist[1:3];
	output[4:6] = 1/cos(rpy[2]) * [cos(rpy[2]), sin(rpy[1])*sin(rpy[2]), cos(rpy[1])*sin(rpy[2]); 0, cos(rpy[1])*cos(rpy[2]), -sin(rpy[1])*cos(rpy[2]); 0, sin(rpy[1]), cos(rpy[1])] * twist[4:6];
implementation_end;
      Splitter1 512 64
       description '<Description><Version>4.0</Version>
   <LibraryPath>Signal\Block Diagram\Splitter.emx</LibraryPath>
  <TimeStamp>2008-01-17 11:28:29</TimeStamp>
<IsMainModel>1</IsMainModel>
 <KeepParameterValues>False</KeepParameterValues>
</Description>';
       knot Splitter
        ports
         signal knot duplicatable out output [4,4];
         signal knot in input [4,4];
       end;
       icon bg ellipse
        figures
         ellipse 508.8 60.8 515.2 67.2 color -1 fill 0;
         ellipse 507.7 59.7 516.3 68.3 color -1;
        terminals
         input 512 64 fixed;
       end;
       implementation eq
equations
    collect (output) = input;
implementation_end;
      Wrap 784 384
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in input [3,1];
         signal out output [3,1];
       end;
       implementation eq
equations
    output[1] = input[1] - 2*3.14159265 * floor((input[1] + 3.14159265) / (2*3.14159265));
    output[2] = input[2] - 2*3.14159265 * floor((input[2] + 3.14159265) / (2*3.14159265));
    output[3] = input[3] - 2*3.14159265 * floor((input[3] + 3.14159265) / (2*3.14159265));implementation_end;
     end;
     connections
      Demux\output2 -> Wrap\input 952 304 952 384;
      FlowSensor1\flow -> Rot\twist;
      FlowSensor1\p2 => wrench_ipp;
      i_com\wrench_com => OneJunction\p;
      Integrate\output -> Demux\input;
      ipp_com\wrench_com <= OneJunction\p;
      ipp_com\wrench_out => FlowSensor1\p1;
      MSe\gravity => OneJunction\p;
      OneJunction\p => Body\wrench_com;
      Rot\output -> Integrate\input;
      Splitter1\output -> MSe\T_next;
      Splitter1\output -> Rot\T 688 64 688 304;
      T_next -> Splitter1\input;
      Wrap\output -> Rot\rpy 688 384 688 320;
      wrench_i => i_com\wrench_in;
     end;
    implementation_end;
