</Description>';
 type PowerDemux
  ports
   power out vel_i [3,1];
   power in twist_i [6,1];
   power out w_i [3,1];
  restrictions
   causality constraint not_equal vel_i twist_i;
   causality constraint not_equal w_i twist_i;
   causality fixed out twist_i;
   causality fixed in vel_i;
   causality fixed in w_i;
 end;
