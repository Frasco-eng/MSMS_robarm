         signal out output;
       end;
       icon bg bottom
        figures
         rectangle 504.1 120 535.9 152 color 0 fill 15132390;
         text 'K' 520 136 color 16711680 16 bold;
       end;
       implementation eq
parameters
	real oneup K;		// gain
	real oneup Ki;
equations
	output = K * input + Ki * int(input[1]);
    implementation_end;
