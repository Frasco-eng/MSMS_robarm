	p.e = ((b_f_pos - b_f_neg) / 2) * 2 / 3.14159 * arctan(p.f - tan(1.570796 * ((b_f_pos + b_f_neg)/2) / ((b_f_pos - b_f_neg) / 2) )) + (b_f_pos + b_f_neg)/2 + b_w * p.f;implementation_end;
      TF 360 280
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\TF.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:43:47</TimeStamp>
</Description>
</Information>';
       type TF
        ports
         power in p1;
         power out p2;
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse bottom
        figures
         text 'TF' 360 280 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup N;
equations
	p1.e = N * p2.e;
	p2.f = N * p1.f;
implementation_end;
