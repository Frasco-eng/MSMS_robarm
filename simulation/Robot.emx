   GravityTerm 1272 -40
    description '<Information>
  <Description>
    <Version>5.1</Version>
    <LibraryPath>GravityTerm.emx</LibraryPath>
    <IsMainModel>1</IsMainModel>
    <KeepParameterValues>False</KeepParameterValues>
    <TimeStamp>2026-5-17 18:41:50</TimeStamp>
    <AllowLibraryUpdate>False</AllowLibraryUpdate>
  </Description>
</Information>';
    type 'Submodel-Equation'
     ports
      signal in T_1 [4,4];
      signal in T_2 [4,4];
      signal in T_3 [4,4];
      signal in T_4 [4,4];
      signal in T_5 [4,4];
      signal in T_6 [4,4];
      signal out tau_g [6,1];
     parameters
      real r_gp_1[3,1] = [0.0; -0.02561; 0.00193];
      real r_gp_2[3,1] = [0.2125; 0.0; 0.11336];
      real r_gp_3[3,1] = [0.15; 0.0; 0.0265];
      real r_gp_4[3,1] = [0.0; -0.0018; 0.01634];
      real r_gp_5[3,1] = [0.0; 0.0018; 0.01634];
      real r_gp_6[3,1] = [0.0; 0.0; -0.001159];
      real g[3,1] = [0.0; 0.0; -9.81];
      real m_1 = 3.7;
      real m_2 = 8.393;
      real m_3 = 2.33;
      real m_4 = 1.1219;
      real m_5 = 1.1219;
      real m_6 = 0.1879;
      real m_load = 1.0;
    end;
    implementation eq
variables
    real z_0[3,1];
    real p_0[3,1];

    real z_1[3,1]; real z_2[3,1]; real z_3[3,1]; 
    real z_4[3,1]; real z_5[3,1]; real z_6[3,1];

    real p_com_1[3,1]; real p_com_2[3,1]; real p_com_3[3,1];
    real p_com_4[3,1]; real p_com_5[3,1]; real p_com_6[3,1];

    real p_1[3,1]; real p_2[3,1]; real p_3[3,1];
    real p_4[3,1]; real p_5[3,1]; real p_6[3,1];

    real tau_1; real tau_2; real tau_3;
    real tau_4; real tau_5; real tau_6;


equations
    z_0 = [0.0; 0.0; 1.0];
    p_0 = [0.0; 0.0; 0.0];

    p_1 = T_1[1:3,4];
    p_2 = T_2[1:3,4];
    p_3 = T_3[1:3,4];
    p_4 = T_4[1:3,4];
    p_5 = T_5[1:3,4];
    p_6 = T_6[1:3,4];

    p_com_1 = T_1[1:3,1:3] * r_gp_1 + p_1;
    p_com_2 = T_2[1:3,1:3] * r_gp_2 + p_2;
    p_com_3 = T_3[1:3,1:3] * r_gp_3 + p_3;
    p_com_4 = T_4[1:3,1:3] * r_gp_4 + p_4;
    p_com_5 = T_5[1:3,1:3] * r_gp_5 + p_5;
    p_com_6 = T_6[1:3,1:3] * r_gp_6 + p_6;

    z_1 = T_1[1:3,3];
    z_2 = T_2[1:3,3];
    z_3 = T_3[1:3,3];
    z_4 = T_4[1:3,3];
    z_5 = T_5[1:3,3];
    z_6 = T_6[1:3,3];

    tau_1 = transpose(g) * (m_1*cross(z_0, p_com_1 - p_0) + m_2*cross(z_0, p_com_2 - p_0) + m_3*cross(z_0, p_com_3 - p_0) + m_4*cross(z_0, p_com_4 - p_0) + m_5*cross(z_0, p_com_5 - p_0) + (m_6+m_load)*cross(z_0, p_com_6 - p_0));
    tau_2 = transpose(g) * (m_2*cross(z_1, p_com_2 - p_1) + m_3*cross(z_1, p_com_3 - p_1) + m_4*cross(z_1, p_com_4 - p_1) + m_5*cross(z_1, p_com_5 - p_1) + (m_6+m_load)*cross(z_1, p_com_6 - p_1));
    tau_3 = transpose(g) * (m_3*cross(z_2, p_com_3 - p_2) + m_4*cross(z_2, p_com_4 - p_2) + m_5*cross(z_2, p_com_5 - p_2) + (m_6+m_load)*cross(z_2, p_com_6 - p_2));
    tau_4 = transpose(g) * (m_4*cross(z_3, p_com_4 - p_3) + m_5*cross(z_3, p_com_5 - p_3) + (m_6+m_load)*cross(z_3, p_com_6 - p_3));
    tau_5 = transpose(g) * (m_5*cross(z_4, p_com_5 - p_4) + (m_6+m_load)*cross(z_4, p_com_6 - p_4));
    tau_6 = transpose(g) * ((m_6+m_load)*cross(z_5, p_com_6 - p_5));

    // Output mapping
    tau_g = [tau_1; tau_2; tau_3; tau_4; tau_5; tau_6];implementation_end;
   HarmonicDrive 168 272
    description '<Information>
  <Description>
    <Version>5.1</Version>
    <LibraryPath>HarmonicDrive.emx</LibraryPath>
    <IsMainModel>1</IsMainModel>
    <KeepParameterValues>True</KeepParameterValues>
    <TimeStamp>2026-5-17 11:52:56</TimeStamp>
    <AllowLibraryUpdate>False</AllowLibraryUpdate>
  </Description>
</Information>';
    type 'Submodel-Graphical'
     ports
      power in motor;
      power out harmonic_drive;
     restrictions
      causality fixed in motor;
      causality fixed out harmonic_drive;
     parameters
      real J = 8.0e-6;
      real N = -0.01;
      real b_w = 6.4e-4;
      real b_f_pos = 0.008;
      real b_f_neg = -0.007;
      real T_1 = 7.0;
      real T_2 = 25;
      real k_2 = 25000.0;
      real k_3 = 29000.0;
      real k_1 = 16000.0;
    end;
    implementation bg
     submodels
      C 408 208
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\C.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:58:35</TimeStamp>
</Description>
</Information>';
       type C
        ports
         power in p;
         signal out state;
        restrictions
         causality preferred out p;
       end;
       icon bg ellipse bottom
        figures
         text 'C' 408 208 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup k_1;
	real oneup k_2;
	real oneup k_3;
	real oneup T_1;
	real oneup T_2;
variables
	real phi_1;
	real phi_2;
equations
	phi_1 = T_1 / k_1;
	phi_2 = phi_1 + (T_2 - T_1) / k_2;
	
	state = int(p.f);
	
	if state <= phi_1 then
		p.e = state * k_1;
	elsif state < phi_2 then
		p.e = (state - phi_1) * k_2 + T_1;
	else
		p.e = (state - phi_2) * k_3 + T_2;
	end;

implementation_end;
      I 264 208
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\I.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:55:55</TimeStamp>
</Description>
</Information>';
       type I
        ports
         power in p;
         signal out state;
        restrictions
         causality preferred in p;
       end;
       icon bg ellipse bottom
        figures
         text 'I' 264 208 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup J;
equations
    state = int(p.e);
    p.f = state / J;
implementation_end;
