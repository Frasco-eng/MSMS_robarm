	// p.e = b_f_mean * 2 / 3.14159 * arctan(p.f - b_f_phase) + b_f_off + b_w * p.f;
	
	p.e = ((b_f_pos - b_f_neg) / 2) * 2 / 3.14159 * arctan(p.f - tan(1.570796 * ((b_f_pos + b_f_neg)/2) / ((b_f_pos - b_f_neg) / 2) )) + (b_f_pos + b_f_neg)/2 + b_w * p.f;implementation_end;
