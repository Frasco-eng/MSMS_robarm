      R 520 208
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
       type R
        ports
         power in p;
       end;
       icon bg ellipse bottom
        figures
         text 'R' 520 208 color 0 18 bold;
       end;
       implementation eq
parameters
	real B_plus = 0.4;
	real B_minus = -0.4;
	real global b_w;

equations
	// real b_f_mean;
	// real b_f_off;
	// real b_f_phase;
	// b_f_mean = (B_plus - B_minus) / 2;
	// b_f_off = (B_plus + B_minus)/2;
	// b_f_phase = tan(1.570796 * b_f_off / b_f_mean);
	p.e = ((B_plus - B_minus) / 2) * 2 / 3.14159 * arctan(p.f - tan(1.570796 * ((B_plus + B_minus)/2) / ((B_plus - B_minus) / 2) )) + (B_plus + B_minus)/2 + b_w * p.f;implementation_end;
      R1 544 344
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
       type R
        ports
         power in p;
       end;
       icon bg ellipse bottom
        figures
         text 'R' 544 344 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup b_f_pos;
	real oneup b_f_neg;
	real oneup b_w;
equations
	// real b_f_mean;
	// real b_f_off;
	// real b_f_phase;
	// b_f_mean = (b_f_pos - b_f_neg) / 2;
	// b_f_off = (b_f_pos + b_f_neg)/2;
	// b_f_phase = tan(1.570796 * b_f_off / b_f_mean);
	// p.e = b_f_mean * 2 / 3.14159 * arctan(p.f - b_f_phase) + b_f_off + b_w * p.f;
	
	p.e = ((b_f_pos - b_f_neg) / 2) * 2 / 3.14159 * arctan(p.f - tan(1.570796 * ((b_f_pos + b_f_neg)/2) / ((b_f_pos - b_f_neg) / 2) )) + (b_f_pos + b_f_neg)/2 + b_w * p.f;implementation_end;
      R2 264 344
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
       type R
        ports
         power in p;
       end;
       icon bg ellipse bottom
        figures
         text 'R' 264 344 color 0 18 bold;
       end;
       implementation eq
parameters
	real global b_f_pos;
	real global b_f_neg;
	real global b_w;
equations
	// real b_f_mean;
	// real b_f_off;
	// real b_f_phase;
	// b_f_mean = (b_f_pos - b_f_neg) / 2;
	// b_f_off = (b_f_pos + b_f_neg)/2;
	// b_f_phase = tan(1.570796 * b_f_off / b_f_mean);
	// p.e = b_f_mean * 2 / 3.14159 * arctan(p.f - b_f_phase) + b_f_off + b_w * p.f;
	
	p.e = ((b_f_pos - b_f_neg) / 2) * 2 / 3.14159 * arctan(p.f - tan(1.570796 * ((b_f_pos + b_f_neg)/2) / ((b_f_pos - b_f_neg) / 2) )) + (b_f_pos + b_f_neg)/2 + b_w * p.f;implementation_end;
