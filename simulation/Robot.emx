parameters
	real oneup b_f_pos;
	real oneup b_f_neg;
variables
	real b_f_mean;
	real b_f_off;
	real b_f_phase;
equations
	b_f_mean = (b_f_pos - b_f_neg) / 2;
	b_f_off = (b_f_pos + b_f_neg)/2;
	b_f_phase = tan(1.570796 * b_f_off / b_f_mean);
