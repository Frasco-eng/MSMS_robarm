       implementation eq
parameters
	real oneup r_gp[3,1];
	real skew_rgp [3,3] = [0, - r_gp[3],  r_gp[2];  r_gp[3], 0, - r_gp[1]; - r_gp[2], r_gp[1], 0];

equations
	wrench_in.f[1:3] = wrench_com.f[1:3] - skew_rgp * wrench_com.f[4:6];
	wrench_in.f[4:6] = wrench_com.f[4:6];
	wrench_com.e[4:6] = wrench_in.e[4:6] + skew_rgp * wrench_in.e[1:3];
	wrench_com.e[1:3] = wrench_in.e[1:3];
implementation_end;
