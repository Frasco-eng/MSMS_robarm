    type 'Submodel-Graphical'
     ports
      power in motor;
      power out harmonic_drive;
     restrictions
      causality fixed in motor;
      causality fixed out harmonic_drive;
     parameters
      real J = 8.0e-6;
      real N = -0.01;
      real b_w = 6.4e-4;
      real b_f_pos = 0.008;
      real b_f_neg = -0.007;
      real T_1 = 7.0;
      real T_2 = 25.0;
