       icon bg ellipse bottom
        figures
         text 'C' 408 208 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup k_1;
	real oneup k_2;
	real oneup k_3;
	real oneup T_1;
	real oneup T_2;
variables
	real phi_1;
	real phi_2;
equations
	phi_1 = T_1 / k_1;
	phi_2 = phi_1 + (T_2 - T_1) / k_2;
	
	state = int(p.f);
	
	if state <= phi_1 then
		p.e = state * k_1;
	elsif state < phi_2 then
		p.e = (state - phi_1) * k_2 + T_1;
	else
		p.e = (state - phi_2) * k_3 + T_2;
	end;

implementation_end;
