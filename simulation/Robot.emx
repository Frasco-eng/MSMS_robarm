      ipp_com 352 280
       description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\MTF.emx</LibraryPath><TimeStamp>2011-11-29 16:15:31</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type MTF
        ports
         power out wrench_out [6,1];
         power in wrench_com [6,1];
        restrictions
         causality constraint not_equal wrench_out wrench_com;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 352 280 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup r_gp[3,1];

equations
	wrench_out.f[1:3] = wrench_com.f[1:3] + cross(r_gp, wrench_com.f[4:6]);
	wrench_out.f[4:6] = wrench_com.f[4:6];
	wrench_com.e[4:6] = wrench_out.e[4:6] - cross(r_gp, wrench_out.e[1:3]);
	wrench_com.e[1:3] = wrench_out.e[1:3];
implementation_end;
      i_com 384 120
       description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\MTF.emx</LibraryPath><TimeStamp>2011-11-29 16:15:31</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type MTF
        ports
         power in wrench_in [6,1];
         power out wrench_com [6,1];
        restrictions
         causality constraint not_equal wrench_in wrench_com;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 384 120 color 0 18 bold;
       end;
       implementation eq
parameters
	real global r_gp[3,1];

equations
	wrench_in.f[1:3] = wrench_com.f[1:3] + cross(r_gp, wrench_com.f[4:6]);
	wrench_in.f[4:6] = wrench_com.f[4:6];
	wrench_com.e[4:6] = wrench_in.e[4:6] - cross(r_gp, wrench_in.e[1:3]);
	wrench_com.e[1:3] = wrench_in.e[1:3];
implementation_end;
      MSe 512 104
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MSe.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:12:33</TimeStamp>
</Description>
</Information>';
       type MSe
        ports
         power out gravity [6,1];
         signal in T_next [4,4];
        restrictions
         causality fixed out gravity;
       end;
       icon bg ellipse bottom
        figures
         text 'MSe' 512 104 color 0 18 bold;
       end;
       implementation eq
parameters
	real global m;
	real effort[3,1] = [0; 0; -9.81];
variables
	real flow[6,1];
equations
	gravity.e[1:3] = transpose(T_next[1:3, 1:3]) * effort * m;
	gravity.e[4:6] = [0; 0; 0];
	flow = gravity.f;implementation_end;
