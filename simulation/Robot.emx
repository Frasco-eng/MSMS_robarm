      MTF\T_i -> T_i;
      MTF\twist_ipp => twist_ipp;
      Mux\output -> Q;
      PowerDemux\vel_i => ZeroJunction\p;
      PowerDemux\w_i => PowerDemux1\w_i;
      PowerDemux1\w_xy => ZeroJunction1\p;
      PowerDemux1\w_z => ZeroJunction2\p;
      PowerMux\twist_i => MTF\twist_i;
      PowerMux1\w_i => PowerMux\w_i;
      Splitter1\output -> MTF\theta;
      Splitter1\output -> Mux\input1 568 344;
      Splitter2\output -> Integrate\input;
      Splitter2\output -> Mux\input2 440 360;
      twist_i => PowerDemux\twist_i;
      Vel_constr\p <= ZeroJunction\p;
      ZeroJunction\p => PowerMux\vel_i;
      ZeroJunction1\p => Omega_constr\p;
      ZeroJunction1\p => PowerMux1\w_xy;
      ZeroJunction2\p => PowerMux1\w_z;
     end;
    implementation_end;
