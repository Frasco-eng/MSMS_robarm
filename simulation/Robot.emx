    type 'Submodel-Equation'
     ports
      signal in T_1 [4,4];
      signal in T_2 [4,4];
      signal in T_3 [4,4];
      signal in T_4 [4,4];
      signal in T_5 [4,4];
      signal in T_6 [4,4];
      signal out tau_g [6,1];
     parameters
      real r_gp_1[3,1] = [0.0; -0.02561; 0.00193];
      real r_gp_2[3,1] = [0.2125; 0.0; 0.11336];
      real r_gp_3[3,1] = [0.15; 0.0; 0.0265];
      real r_gp_4[3,1] = [0.0; -0.0018; 0.01634];
      real r_gp_5[3,1] = [0.0; 0.0018; 0.01634];
      real r_gp_6[3,1] = [0.0; 0.0; -0.001159];
      real g[3,1] = [0.0; 0.0; -9.81];
      real m_1 = 3.7;
      real m_2 = 8.393;
      real m_3 = 2.33;
      real m_4 = 1.1219;
      real m_5 = 1.1219;
      real m_6 = 0.1879;
    end;
    implementation eq
 parameters
	 real z_0[3,1] = [0.0; 0.0; 1.0];
    real p_0[3,1] = [0.0; 0.0; 0.0];

variables

    // real z_1[3,1]; real z_2[3,1]; real z_3[3,1]; 
    // real z_4[3,1]; real z_5[3,1]; real z_6[3,1];

    // real p_com_1[3,1]; real p_com_2[3,1]; real p_com_3[3,1];
    // real p_com_4[3,1]; real p_com_5[3,1]; real p_com_6[3,1];

    // real p_1[3,1]; real p_2[3,1]; real p_3[3,1];
    // real p_4[3,1]; real p_5[3,1]; real p_6[3,1];

    real tau_1; real tau_2; real tau_3;
    real tau_4; real tau_5; real tau_6;

equations

    // p_1 = T_1[1:3,4];
    // p_2 = T_2[1:3,4];
    // p_3 = T_3[1:3,4];
    // p_4 = T_4[1:3,4];
    // p_5 = T_5[1:3,4];
    // p_6 = T_6[1:3,4];

    // p_com_1 = T_1[1:3,1:3] * r_gp_1 + p_1;
    // p_com_2 = T_2[1:3,1:3] * r_gp_2 + p_2;
    // p_com_3 = T_3[1:3,1:3] * r_gp_3 + p_3;
    // p_com_4 = T_4[1:3,1:3] * r_gp_4 + p_4;
    // p_com_5 = T_5[1:3,1:3] * r_gp_5 + p_5;
    // p_com_6 = T_6[1:3,1:3] * r_gp_6 + p_6;

    // z_1 = T_1[1:3,3];
    // z_2 = T_2[1:3,3];
    // z_3 = T_3[1:3,3];
    // z_4 = T_4[1:3,3];
    // z_5 = T_5[1:3,3];
    // z_6 = T_6[1:3,3];

    // tau_1 = transpose(g) * (m_1*cross(z_0, p_com_1 - p_0) + m_2*cross(z_0, p_com_2 - p_0) + m_3*cross(z_0, p_com_3 - p_0) + m_4*cross(z_0, p_com_4 - p_0) + m_5*cross(z_0, p_com_5 - p_0) + (m_6+m_load_ctrl)*cross(z_0, p_com_6 - p_0));
    // tau_2 = transpose(g) * (m_2*cross(z_1, p_com_2 - p_1) + m_3*cross(z_1, p_com_3 - p_1) + m_4*cross(z_1, p_com_4 - p_1) + m_5*cross(z_1, p_com_5 - p_1) + (m_6+m_load_ctrl)*cross(z_1, p_com_6 - p_1));
    // tau_3 = transpose(g) * (m_3*cross(z_2, p_com_3 - p_2) + m_4*cross(z_2, p_com_4 - p_2) + m_5*cross(z_2, p_com_5 - p_2) + (m_6+m_load_ctrl)*cross(z_2, p_com_6 - p_2));
    // tau_4 = transpose(g) * (m_4*cross(z_3, p_com_4 - p_3) + m_5*cross(z_3, p_com_5 - p_3) + (m_6+m_load_ctrl)*cross(z_3, p_com_6 - p_3));
    // tau_5 = transpose(g) * (m_5*cross(z_4, p_com_5 - p_4) + (m_6+m_load_ctrl)*cross(z_4, p_com_6 - p_4));
    // tau_6 = transpose(g) * ((m_6+m_load_ctrl)*cross(z_5, p_com_6 - p_5));
	
	 tau_6 = transpose(g) * cross(T_5[1:3,3], (m_6)*(T_6[1:3,1:3]*r_gp_6 + T_6[1:3,4] - T_5[1:3,4]));     
	 tau_5 = transpose(g) * cross(T_4[1:3,3], m_5*(T_5[1:3,1:3]*r_gp_5 + T_5[1:3,4] - T_4[1:3,4]) + (m_6)*(T_6[1:3,1:3]*r_gp_6 + T_6[1:3,4] - T_4[1:3,4]));     
	 tau_4 = transpose(g) * cross(T_3[1:3,3], m_4*(T_4[1:3,1:3]*r_gp_4 + T_4[1:3,4] - T_3[1:3,4]) + m_5*(T_5[1:3,1:3]*r_gp_5 + T_5[1:3,4] - T_3[1:3,4]) + (m_6)*(T_6[1:3,1:3]*r_gp_6 + T_6[1:3,4] - T_3[1:3,4]));     
	 tau_3 = transpose(g) * cross(T_2[1:3,3], m_3*(T_3[1:3,1:3]*r_gp_3 + T_3[1:3,4] - T_2[1:3,4]) + m_4*(T_4[1:3,1:3]*r_gp_4 + T_4[1:3,4] - T_2[1:3,4]) + m_5*(T_5[1:3,1:3]*r_gp_5 + T_5[1:3,4] - T_2[1:3,4]) + (m_6)*(T_6[1:3,1:3]*r_gp_6 + T_6[1:3,4] - T_2[1:3,4]));     
	 tau_2 = transpose(g) * cross(T_1[1:3,3], m_2*(T_2[1:3,1:3]*r_gp_2 + T_2[1:3,4] - T_1[1:3,4]) + m_3*(T_3[1:3,1:3]*r_gp_3 + T_3[1:3,4] - T_1[1:3,4]) + m_4*(T_4[1:3,1:3]*r_gp_4 + T_4[1:3,4] - T_1[1:3,4]) + m_5*(T_5[1:3,1:3]*r_gp_5 + T_5[1:3,4] - T_1[1:3,4]) + (m_6)*(T_6[1:3,1:3]*r_gp_6 + T_6[1:3,4] - T_1[1:3,4]));     
	 tau_1 = transpose(g) * cross(z_0, m_1*(T_1[1:3,1:3]*r_gp_1 + T_1[1:3,4] - p_0) + m_2*(T_2[1:3,1:3]*r_gp_2 + T_2[1:3,4] - p_0) + m_3*(T_3[1:3,1:3]*r_gp_3 + T_3[1:3,4] - p_0) + m_4*(T_4[1:3,1:3]*r_gp_4 + T_4[1:3,4] - p_0) + m_5*(T_5[1:3,1:3]*r_gp_5 + T_5[1:3,4] - p_0) + (m_6)*(T_6[1:3,1:3]*r_gp_6 + T_6[1:3,4] - p_0));
	 
	
    // Output mapping
    tau_g = [tau_1; tau_2; tau_3; tau_4; tau_5; tau_6];implementation_end;
