       type MSe
        ports
         power out gravity [6,1];
         signal in T_next [4,4];
        restrictions
         causality fixed out gravity;
       end;
       icon bg ellipse bottom
        figures
         text 'MSe' 512 88 color 0 18 bold;
       end;
       implementation eq
parameters
	real global m;
	real effort[3,1] = [0; 0; -9.81];
variables
	real flow[6,1];
equations
	gravity.e[1:3] = transpose(T_next[1:3, 1:3]) * effort * m;
	gravity.e[4:6] = [0; 0; 0];
	flow = gravity.f;implementation_end;
      plug wrench_i 264 88;
      plug wrench_ipp 264 288;
      plug T_next 512 16;
      OneJunction 512 176
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\OneJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:17:51</TimeStamp>
</Description>
</Information>';
       knot OneJunction
        ports
         power knot duplicatable none p [6,1];
         signal knot out flow [6,1];
        restrictions
         causality constraint one_out p;
       end;
       icon bg ellipse
        figures
         text '1' 512 176 color 0 18 bold;
       end;
       implementation eq
equations
	sum (direct (p.e)) = 0;
	equal (collect (p.f));
	flow = first (p.f);
implementation_end;
     end;
     connections
      i_com\wrench_com => OneJunction\p;
      ipp_com\wrench_com <= OneJunction\p;
      MSe\gravity => OneJunction\p;
      OneJunction\p => Body\wrench_com;
      T_next -> MSe\T_next;
      wrench_i => i_com\wrench_in;
      wrench_ipp <= ipp_com\wrench_out;
     end;
    implementation_end;
