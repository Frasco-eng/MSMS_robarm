      Filter 384 200
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Block Diagram\Filter.emx</LibraryPath>
  <TimeStamp>2007-9-26 12:15:20</TimeStamp>
  <AllowLibraryUpdate>False</AllowLibraryUpdate>
</Description>';
       type 'Filter-Generic'
        ports
         signal in u [2,1];
         signal out y [2,1];
       end;
       icon bg bottom
        figures
         rectangle 354 185 414 215 color 0 fill 15132390;
         text 'LP-2' 384 195 color 16711680 14 bold;
         text 'Butterworth' 384 207 color 0;
       end;
       implementation eq
// 20-sim Filter Editor
// 'Generic Filter' 2 5000 10 20 lp butter
variables
	real hidden n[3], d[3];
	real hidden s[2];
initialequations
	// create numerator and denominator coefficients
	n = [0.0; 0.0; 9.869604401089358e8];
	d = [1.0; 44428.82938158367; 9.869604401089363e8];
equations
	// the actual dynamic equations
	s = int ( [
		n[3] * u - d[3] * y;
		n[2] * u - d[2] * y + s[1]
	] );
	y = (1/d[1]) * (n[1] * u + s[2]);
implementation_end;
      Gain 520 136
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Block Diagram\Gain.emx</LibraryPath>
  <TimeStamp>2007-9-26 12:15:12</TimeStamp>
</Description>';
       type Gain
