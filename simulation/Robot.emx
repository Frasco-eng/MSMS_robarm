    type Submodel
     ports
      signal in T_prev [4,4];
      signal in T_i [4,4];
      signal out T_next [4,4];
      signal out pose_abs [6,1];
      signal in pos_rel [3,1];
    end;
    implementation eq
equations
	T_next = T_prev * T_i;
	pose_abs[1:4] = (T_next * [pos_rel[1];pos_rel[2];pos_rel[3];1]);
	pose_abs[4] = atan2(T_next[3,2], T_next[3,3]);
	pose_abs[5] = atan2(-T_next[3,1], sqrt(sqr(T_next[1,1])+sqr(T_next[2,1])));
	pose_abs[6] = atan2(T_next[2,1], T_next[1,1]);
	implementation_end;
