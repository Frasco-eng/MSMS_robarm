       description '<Information><Description><Version>4.0</Version><LibraryPath>System\Submodel.emx</LibraryPath><TimeStamp>2007-10-31 11:32:54</TimeStamp><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type Submodel
        ports
         power in wrench_com [6,1];
        restrictions
         causality fixed in wrench_com;
       end;
       implementation eq
parameters 
	real oneup m;
	real oneup J;
	real oneup twist_init;
variables 
	real dp[3];
	real dh[3];
equations
	dp = wrench_com.e[1:3] - m * cross(wrench_com.f[4:6], wrench_com.f[1:3]);
	dh = wrench_com.e[4:6] - cross(wrench_com.f[4:6], J * wrench_com.f[4:6]);
	wrench_com.f[1:3] = int(dp) / m;
	wrench_com.f[4:6] = inverse(J) * int(dh);implementation_end;
      ipp_com 384 248
       description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\MTF.emx</LibraryPath><TimeStamp>2011-11-29 16:15:31</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type MTF
        ports
         power out wrench_out [6,1];
         power in wrench_com [6,1];
        restrictions
         causality constraint not_equal wrench_out wrench_com;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 384 248 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup r_gp[3,1];

equations
	wrench_out.f[1:3] = wrench_com.f[1:3] + cross(r_gp, wrench_com.f[4:6]);
	wrench_out.f[4:6] = wrench_com.f[4:6];
	wrench_com.e[4:6] = wrench_out.e[4:6] - cross(r_gp, wrench_out.e[1:3]);
	wrench_com.e[1:3] = wrench_out.e[1:3];
implementation_end;
