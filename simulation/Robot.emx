   HarmonicDrive_1 136 272
    description '<Information><Description><Version>5.1</Version><LibraryPath>HarmonicDrive.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2026-5-17 11:52:56</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Graphical'
     ports
      power in motor;
      power out harmonic_drive;
     restrictions
      causality fixed in motor;
      causality fixed out harmonic_drive;
     parameters
      real J = 8.0e-6;
      real N = -0.01;
      real b_w = 6.4e-4;
      real b_f_pos = 0.008;
      real b_f_neg = -0.007;
      real T_1 = 7.0;
      real T_2 = 25;
      real k_2 = 25000.0;
      real k_3 = 29000.0;
      real k_1 = 16000.0;
    end;
    implementation bg
     submodels
      C 408 208
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\C.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:58:35</TimeStamp>
</Description>
</Information>';
       type C
        ports
         power in p;
         signal out state;
        restrictions
         causality preferred out p;
       end;
       icon bg ellipse bottom
        figures
         text 'C' 408 208 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup k_1;
	real oneup k_2;
	real oneup k_3;
	real oneup T_1;
	real oneup T_2;
variables
	real phi_1;
	real phi_2;
equations
	phi_1 = T_1 / k_1;
	phi_2 = phi_1 + (T_2 - T_1) / k_2;
	
	state = int(p.f);
	
	if state <= phi_1 then
		p.e = state * k_1;
	elsif state < phi_2 then
		p.e = (state - phi_1) * k_2 + T_1;
	else
		p.e = (state - phi_2) * k_3 + T_2;
	end;

implementation_end;
      I 264 208
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\I.emx</LibraryPath>
