     restrictions
      causality fixed out ee;
      causality fixed in source_effort;
      causality fixed out one;
      causality fixed in constrainer;
    end;
    icon bg ellipse
     figures
      text 'X0' 1320 192 color 8388608 18 bold;
    end;
    implementation eq
equations
	ee.e = if condition then constrainer.e else source_effort.e end;
	one.e = if condition then constrainer.e else [0; 0; 0; 0; 0; 0] end;
	source_effort.f = if condition then [0;0;0;0;0;0] else (one.f - ee.f) end;
	constrainer.f = if condition then (- one.f + ee.f) else [0;0;0;0;0;0] end;
	
 implementation_end;
  end;
