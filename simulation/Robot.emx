      MTF 760 168
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MTF.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:15:31</TimeStamp>
</Description>
</Information>';
       type MTF
        ports
         power in twist_i [6,1];
         power out twist_ipp [6,1];
         signal in theta;
         signal out T_i [4,4];
        restrictions
         causality constraint not_equal twist_i twist_ipp;
         causality fixed in twist_i;
         causality fixed out twist_ipp;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 760 168 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup d_i;
	real oneup a_i;
	real oneup alpha_i;
	real oneup theta_off_i;
variables
	real angle; 
	real R [3,3]; 
	real P [3,1];
	real skew_P [3,3];
equations
	angle = theta + theta_off_i;
	R = [cos(angle), -sin(angle)*cos(alpha_i), sin(angle)*sin(alpha_i); sin(angle), cos(angle)*cos(alpha_i), -cos(angle)*sin(alpha_i); 0, sin(alpha_i), cos(alpha_i)];
	P = [a_i * cos(angle); a_i * sin(angle); d_i];
	skew_P = [0, -P[3], P[2]; P[3], 0, -P[1]; -P[2], P[1], 0];
	
	twist_ipp.e[1:3] = transpose(R) * twist_i.e[1:3];
	twist_ipp.e[4:6] = transpose(R) * twist_i.e[4:6] - transpose(R) * skew_P * twist_i.e[1:3];
	
	twist_i.f[4:6] = R *(twist_ipp.f[4:6]);
	twist_i.f[1:3] = R * skew_P * twist_i.f[4:6] + R * twist_ipp.f[1:3];
	
	
	
	T_i[1:3, 1:3] = R;
	T_i[1:3, 4] = P;
	T_i[4, 1:4] = [0,0,0,1];implementation_end;
      plug twist_i 56 168;
      plug twist_ipp 912 168;
      plug actuator 392 400;
      plug T_i 760 88;
      Omega_constr 400 184
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         power in p [2,1];
       end;
       implementation eq

equations
	constraint(p.f) = p.e;
 implementation_end;
