	equal (collect (p.e));
	effort = first (p.e);
implementation_end;
     end;
     connections
      motor => OneJunction\p;
      OneJunction\p => I\p;
      OneJunction\p => TF\p1;
      OneJunction1\p => C\p;
      OneJunction1\p => R1\p;
      R\p <= OneJunction\p;
      TF\p2 => ZeroJunction\p;
      ZeroJunction\p => harmonic_drive;
      ZeroJunction\p => OneJunction1\p;
     end;
    implementation_end;
