      C 448 208
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\C.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:58:35</TimeStamp>
</Description>
</Information>';
       type C
        ports
         power in p;
         signal out state;
        restrictions
         causality preferred out p;
       end;
       icon bg ellipse bottom
        figures
         text 'C' 448 208 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup k_1;
	real oneup k_2;
	real oneup k_3;
	real oneup T_1;
	real oneup T_2;
variables
	real phi_1;
	real phi_2;
	// real detm;
	real a;
	real b;
equations
	phi_1 = T_1 / k_1;
	phi_2 = phi_1 + (T_2 - T_1) / k_2;
	
	state = int(p.f);

	// detm = 1/(phi_1*phi_2*(sqr(phi_1)-sqr(phi_2)));
	// a = (phi_2*T_1-phi_1*T_2)*detm;
	// b = (-phi_2^3 * T_1 + phi_1^3 * T_2) * detm;
	a = (phi_2*T_1-phi_1*T_2) * 1/(phi_1*phi_2*(sqr(phi_1)-sqr(phi_2)));
	b = (-phi_2^3 * T_1 + phi_1^3 * T_2) * 1/(phi_1*phi_2*(sqr(phi_1)-sqr(phi_2)));
	
	p.e = a * state^3 + b * state;implementation_end;
