     parameters
      real pos_rel[3,1] = [0.0; 0.095; 0.0];
    end;
    implementation eq
variables
	real R_next[3, 3];
	real R_body[3,3];
	real pose_abs_com[4,1];
equations
	T_next = T_prev * T_i;
	pose_abs[1:4] = (T_next * [0;0;0;1]);
	pose_abs[4] = atan2(T_next[3,2], T_next[3,3]);
	pose_abs[5] = atan2(-T_next[3,1], sqrt(sqr(T_next[1,1])+sqr(T_next[2,1])));
	pose_abs[6] = atan2(T_next[2,1], T_next[1,1]);
	pose_abs_com[1:4] = (T_next * [pos_rel[1]; pos_rel[2]; pos_rel[3]; 1]);
	
	R_next = T_next[1:3, 1:3];
	R_body = T_next[1:3, 1:3] * [1, 0, 0; 0, 0, -1; 0, 1, 0];implementation_end;
