   Planner 560 656
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Equation'
     ports
      signal in pose_des [6,1];
      signal out T_des [4,4];
    end;
    implementation eq
variables
	real Rp[3,3];
	real Rr[3,3];
	real Ry[3,3];
	real R[3,3];
equations
	Rr = [1, 0, 0; 0, cos(pose_des[4,1]), -sin(pose_des[4,1]); 0, sin(pose_des[4,1]), cos(pose_des[4,1])];
	Rp = [cos(pose_des[5,1]), 0, sin(pose_des[5,1]); 0, 1, 0; -sin(pose_des[5,1]), 0, cos(pose_des[5,1])];
	Ry = [cos(pose_des[6,1]), -sin(pose_des[6,1]), 0; sin(pose_des[6,1]), cos(pose_des[6,1]), 0; 0, 0, 1];
	R = Ry * Rp * Rr;
	T_des = [R[1,1], R[1,2], R[1,3], pose_des[1,1]; R[2,1], R[2,2], R[2,3], pose_des[2,1]; R[3,1], R[3,2], R[3,3], pose_des[3,1]; 0, 0, 0, 1];
 implementation_end;
