   Payload 1432 192
    description '<Information><Description><Version>4.2</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\I.emx</LibraryPath><TimeStamp>2011-11-29 15:55:55</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
    type I
     ports
      power in p [6,1];
     restrictions
      causality fixed in p;
     parameters
      real m_load = 1.0;
      real J_load[3,3] = [0.001, 0.0, 0.0; 0.0, 0.001, 0.0; 0.0, 0.0, 0.001];
    end;
    icon bg ellipse bottom
     figures
      text 'I' 1432 192 color 0 18 bold;
    end;
    implementation eq

variables 
	real dp[3];
	real dh[3]; 
equations
	dp = p.e[1:3] - m_load *cross(p.f[4:6], p.f[1:3]);
	dh = p.e[4:6] - cross(p.f[4:6], J_load*p.f[4:6]);
	p.f[1:3] = int(dp) / m_load;
	p.f[4:6] = inverse(J_load) * int(dh);implementation_end;
