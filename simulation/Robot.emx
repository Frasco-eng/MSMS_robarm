  </Description>
</Information>';
    type 'Submodel-Graphical'
     ports
      power in motor;
      power out harmonic_drive;
     restrictions
      causality fixed in motor;
      causality fixed out harmonic_drive;
     parameters
      real J = 8.0e-6;
      real N = -0.01;
      real b_w = 6.4e-4;
      real b_f_pos = 0.008;
      real b_f_neg = -0.007;
      real T_1 = 7.0;
      real T_2 = 25.0;
      real k_2 = 25000.0;
      real k_3 = 29000.0;
      real k_1 = 16000.0;
    end;
    implementation bg
     submodels
      C 456 208
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\C.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:58:35</TimeStamp>
</Description>
</Information>';
       type C
        ports
         power in p;
         signal out state;
        restrictions
         causality preferred out p;
       end;
       icon bg ellipse bottom
        figures
         text 'C' 456 208 color 0 18 bold;
       end;
       implementation eq
parameters
	real oneup k_1;
	real oneup k_2;
	real oneup k_3;
	real oneup T_1;
	real oneup T_2;
variables
	real phi_1;
	real phi_2;
	real detm;
	real a;
	real b;
equations
	phi_1 = T_1 / k_1;
	phi_2 = phi_1 + (T_2 - T_1) / k_2;
	
	state = int(p.f, -9.587628315117347e-4);

	detm = 1/(phi_1*phi_2*(sqr(phi_1)-sqr(phi_2)));
	a = (phi_2*T_1-phi_1*T_2)*detm;
	b = (-phi_2^3 * T_1 + phi_1^3 * T_2) * detm;
	p.e = a * state^3 + b * state;implementation_end;
