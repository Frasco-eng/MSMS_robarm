</Description>
</Information>';
       type Integrate
        ports
         signal in input;
         signal out output;
       end;
       icon bg bottom
        figures
         rectangle 488 288 520 320 color 0 fill 15132390;
         text '∫' 504 304.3 color 16711680 'Lucida Sans' 21 italic;
