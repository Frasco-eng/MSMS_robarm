<IsMainModel>1</IsMainModel>
 <KeepParameterValues>False</KeepParameterValues>
 <AllowLibraryUpdate>True</AllowLibraryUpdate>
</Description>';
 type PowerDemux
  ports
   power out w_xy [2,1];
   power in w_i [3,1];
   power out w_z;
  restrictions
   causality constraint not_equal w_xy w_i;
   causality constraint not_equal w_z w_i;
   causality fixed out w_i;
   causality fixed in w_xy;
   causality fixed in w_z;
 end;
