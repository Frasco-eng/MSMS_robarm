   Transformation_6 1096 104
    description '<Information><Description><Version>5.1</Version><LibraryPath>Transformation.emx</LibraryPath><TimeStamp>2026-5-14 16:15:03</TimeStamp><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
    type Submodel
     ports
      signal in T_prev [4,4];
      signal in T_i [4,4];
      signal out T_next [4,4];
      signal out pose_abs [6,1];
     parameters
      real pos_rel[3,1] = [0.0; 0.0; -0.081];
    end;
    implementation eq
variables
	real R_next[3, 3];
	real R_body[3,3];
	real pose_abs_body[4,1];
	real T_inv[4,4];
	// INITIALIZATION: only for plot testing purpose, remove offset to compare it with dynamics orientation
	real pose_abs_test[6,1];
	real pose_init[6,1];
	real R_init[3,3]; 
	real R_next_test[3,3];
	boolean init;
initialequations
	init = true;
equations
	T_next = T_prev * T_i;
	T_inv = inverse(T_next);
	pose_abs[1:4] = (T_next * [0;0;0;1]);
	pose_abs[4] = atan2(T_next[3,2], T_next[3,3]);
	pose_abs[5] = atan2(-T_next[3,1], sqrt(sqr(T_next[1,1])+sqr(T_next[2,1])));
	pose_abs[6] = atan2(T_next[2,1], T_next[1,1]);
	pose_abs_body[1:4] = (T_next * [pos_rel[1]; pos_rel[2]; pos_rel[3]; 1]);
	
	R_next = T_next[1:3, 1:3];
	R_body = T_next[1:3, 1:3] * [1, 0, 0; 0, 0, -1; 0, 1, 0];
	

	// initialization SETTING 
	
	if init then
		pose_init[1:3] = pose_abs[1:3];
		R_init = R_next; 
		init = false;
	end;
	
	pose_abs_test[1:3] = pose_abs[1:3] - pose_init[1:3];
	R_next_test = transpose(R_init) * R_next;
	pose_abs_test[4] = atan2(R_next_test[3,2], R_next_test[3,3]);
	pose_abs_test[5] = atan2(-R_next_test[3,1], sqrt(sqr(R_next_test[1,1])+sqr(R_next_test[2,1])));
	pose_abs_test[6] = atan2(R_next_test[2,1], R_next_test[1,1]);
	implementation_end;
   Transformation_Body 1552 104
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Equation'
     ports
      signal in T_ee [4,4];
      signal boolean in condition;
      signal out pos_load [3,1];
    end;
    implementation eq
variables
	real R_load[3,3];
	real pos_state[3,1];
	real R_state[3,3];
initialequations
	pos_state = [0.3; 0; 0];
	R_state = [1, 0, 0; 0, 1, 0; 0, 0, 1];
equations
	if condition then
		pos_load[1:3] = T_ee[1:3, 4];
		R_load = T_ee[1:3,1:3];
		pos_state = pos_load;
		R_state = R_load;
	else
		pos_load = pos_state;
		R_load = R_state;
	end;

		
	
	
	
 implementation_end;
   Unwrap 704 656
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Equation'
     ports
      signal in theta_raw [6,1];
      signal out theta_unwrapped [6,1];
      signal in theta_prev [6,1];
    end;
    implementation eq
parameters
    real pi = 3.141592653589793;
    integer n = 6;  
	 boolean enable = true;
 
variables
    integer i; 	 

equations
    
	 if enable then
	    for i = 1 to n do
	        theta_unwrapped[i] = theta_raw[i] - 2.0 * pi * round((theta_raw[i] - theta_prev[i]) / (2.0 * pi));
	    end;
	 else
		 for i = 1 to n do 
	        theta_unwrapped[i] = 0;
	    end;
	 end;implementation_end;
