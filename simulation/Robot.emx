      Wrap 944 328
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in input [3,1];
         signal out output [3,1];
       end;
       implementation eq
equations
    output[1] = input[1] - 2*3.14159265 * floor((input[1] + 3.14159265) / (2*3.14159265));
    output[2] = input[2] - 2*3.14159265 * floor((input[2] + 3.14159265) / (2*3.14159265));
    output[3] = input[3] - 2*3.14159265 * floor((input[3] + 3.14159265) / (2*3.14159265));implementation_end;
     end;
     connections
      Demux\output2 -> Wrap\input 1112 256 1112 328;
