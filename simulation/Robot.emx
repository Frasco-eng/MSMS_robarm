    description '<Information>
  <Description>
    <Version>5.1</Version>
    <LibraryPath>Transformation.emx</LibraryPath>
    <TimeStamp>2026-5-30 08:38:56</TimeStamp>
    <IsMainModel>1</IsMainModel>
