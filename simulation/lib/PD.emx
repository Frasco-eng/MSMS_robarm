<Document>
 <Model version="5.1" build="5.1.6.14106">
  <Sidops>
<![CDATA[PD 160 584 description '<Information>
  <Description>
    <Version>5.1</Version>
    <LibraryPath>PD.emx</LibraryPath>
    <IsMainModel>1</IsMainModel>
    <KeepParameterValues>True</KeepParameterValues>
    <TimeStamp>2026-5-18 12:04:48</TimeStamp>
    <AllowLibraryUpdate>False</AllowLibraryUpdate>
  </Description>
</Information>'; type 'Submodel-Graphical'  ports   signal in Q [2,1];   signal in gravity;   signal out tau;  parameters   real K[1,2] = [1.0, 1.0];   real Q_ref[2,1] = [1.0; 1.0]; end; implementation bg  submodels   Constant 248 136    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>   <LibraryPath>Signal\Sources\Constant.emx</LibraryPath>  <TimeStamp>2007-10-19 14:48:44</TimeStamp></Description>';    type Constant     ports      signal out output [2,1];    end;    icon bg bottom     figures      rectangle 232.1 120 263.9 152 color 0 fill 15132390;      line 236.9 131.6 258.9 131.6 color 16711680 width 2;      line 234.2 142.7 259.9 142.7 color 0;      line 236.5 126.7 236.5 145 color 0;    end;    implementation eqparameters	real oneup Q_ref;		// output valueequations	output = Q_ref;     implementation_end;   Gain 520 136    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>   <LibraryPath>Signal\Block Diagram\Gain.emx</LibraryPath>  <TimeStamp>2007-9-26 12:15:12</TimeStamp></Description>';    type Gain     ports      signal in input [2,1];      signal out output;    end;    icon bg bottom     figures      rectangle 504.1 120 535.9 152 color 0 fill 15132390;      text 'K' 520 136 color 16711680 16 bold;    end;    implementation eqparameters	real oneup K;		// gainequations	output = K * input;    implementation_end;   plug Q 384 256;   plug gravity 648 248;   plug tau 784 136;   PlusMinus 648 136    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>   <LibraryPath>Signal\Block Diagram\PlusMinus.emx</LibraryPath>  <TimeStamp>2007-9-27 10:15:13</TimeStamp></Description>';    knot PlusMinus     ports      signal knot duplicatable in plus [1];      signal knot duplicatable in minus [1];      signal knot out output [1];    end;    icon bg ellipse     figures      ellipse 640 128 656 144 color 0 fill 16777215;    end;    implementation eqequations    output = sum (collect (plus)) - sum (collect (minus));    implementation_end;   PlusMinus1 384 136    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>   <LibraryPath>Signal\Block Diagram\PlusMinus.emx</LibraryPath>  <TimeStamp>2007-9-27 10:15:13</TimeStamp></Description>';    knot PlusMinus     ports      signal knot duplicatable in plus [2,1];      signal knot duplicatable in minus [2,1];      signal knot out output [2,1];    end;    icon bg ellipse     figures      ellipse 376 128 392 144 color 0 fill 16777215;    end;    implementation eqequations    output = sum (collect (plus)) - sum (collect (minus));    implementation_end;  end;  connections   Constant\output -> PlusMinus1\plus;   Gain\output -> PlusMinus\plus;   gravity -> PlusMinus\minus;   PlusMinus\output -> tau;   PlusMinus1\output -> Gain\input;   Q -> PlusMinus1\minus;  end; implementation_end;]]>  </Sidops>
