</Information>'; type Submodel  ports   signal in T_prev [4,4];   signal in T_i [4,4];   signal out T_next [4,4];   signal out pose_abs [6,1];  parameters   real pos_rel[3,1] = [0.0; -0.02561; 0.00193]; end; implementation eqvariables	real R_next[3, 3];	real R_body[3,3];	real pose_abs_body[4,1];equations	T_next = T_prev * T_i;	pose_abs[1:4] = (T_next * [0;0;0;1]);	pose_abs_body[1:4] = (T_next * [pos_rel[1]; pos_rel[2]; pos_rel[3]; 1]);		R_next = T_next[1:3, 1:3];	R_body = T_next[1:3, 1:3] * [1, 0, 0; 0, 0, 1; 0, -1, 0] * [-1, 0, 0; 0, -1, 0; 0, 0, 1];implementation_end;]]>  </Sidops>
