<?xml version="1.0" encoding="UTF-8"?>
<Document>
 <Model version="5.1" build="5.1.6.14106">
  <Sidops>
<![CDATA[HarmonicDrive 272 104 description '<Information>
  <Description>
    <Version>5.1</Version>
    <LibraryPath>HarmonicDrive.emx</LibraryPath>
    <IsMainModel>1</IsMainModel>
    <KeepParameterValues>True</KeepParameterValues>
    <TimeStamp>2026-5-17 11:52:56</TimeStamp>
    <AllowLibraryUpdate>False</AllowLibraryUpdate>
  </Description>
</Information>'; type 'Submodel-Graphical'  ports   power in motor;   power out harmonic_drive;  restrictions   causality fixed in motor;   causality fixed out harmonic_drive;  parameters   real J = 8.0e-6;   real N = -0.01;   real b_w = 6.4e-4;   real b_f_pos = 0.008;   real b_f_neg = -0.007;   real T_1 = 2.0;   real T_2 = 6.9;   real k_2 = 6100.0;   real k_3 = 7100.0;   real k_1 = 4700.0; end; implementation bg  submodels   C 408 208    description '<Information> <Description>    <Version>4.2</Version><IsMainModel>1</IsMainModel>  <KeepParameterValues>False</KeepParameterValues>    <LibraryPath>Bond Graph\C.emx</LibraryPath>  <TimeStamp>2011-11-29 15:58:35</TimeStamp></Description></Information>';    type C     ports      power in p;      signal out state;     restrictions      causality preferred out p;    end;    icon bg ellipse bottom     figures      text 'C' 408 208 color 0 18 bold;    end;    implementation eqparameters	real oneup k_1;	real oneup k_2;	real oneup k_3;	real oneup T_1;	real oneup T_2;variables	real phi_1;	real phi_2;equations	phi_1 = T_1 / k_1;	phi_2 = phi_1 + (T_2 - T_1) / k_2;		state = int(p.f);		if state <= phi_1 then		p.e = state * k_1;	elsif state < phi_2 then		p.e = (state - phi_1) * k_2 + T_1;	else		p.e = (state - phi_2) * k_3 + T_2;	end;implementation_end;   I 264 208    description '<Information> <Description>    <Version>4.2</Version><IsMainModel>1</IsMainModel>  <KeepParameterValues>False</KeepParameterValues>    <LibraryPath>Bond Graph\I.emx</LibraryPath>  <TimeStamp>2011-11-29 15:55:55</TimeStamp></Description></Information>';    type I     ports      power in p;      signal out state;     restrictions      causality preferred in p;    end;    icon bg ellipse bottom     figures      text 'I' 264 208 color 0 18 bold;    end;    implementation eqparameters	real oneup J;equations    state = int(p.e);    p.f = state / J;implementation_end;   plug motor 160 280;   plug harmonic_drive 624 280;   OneJunction 264 280    description '<Information> <Description>    <Version>4.2</Version><IsMainModel>1</IsMainModel>  <KeepParameterValues>False</KeepParameterValues>    <LibraryPath>Bond Graph\OneJunction.emx</LibraryPath>  <TimeStamp>2011-11-29 16:17:51</TimeStamp></Description></Information>';    knot OneJunction     ports      power knot duplicatable none p [1];      signal knot out flow [1];     restrictions      causality constraint one_out p;    end;    icon bg ellipse     figures      text '1' 264 280 color 0 18 bold;    end;    implementation eqequations	sum (direct (p.e)) = 0;	equal (collect (p.f));	flow = first (p.f);implementation_end;   OneJunction1 480 208    description '<Information> <Description>    <Version>4.2</Version><IsMainModel>1</IsMainModel>  <KeepParameterValues>False</KeepParameterValues>    <LibraryPath>Bond Graph\OneJunction.emx</LibraryPath>  <TimeStamp>2011-11-29 16:17:51</TimeStamp></Description></Information>';    knot OneJunction     ports      power knot duplicatable none p [1];      signal knot out flow [1];     restrictions      causality constraint one_out p;    end;    icon bg ellipse     figures      text '1' 480 208 color 0 18 bold;    end;    implementation eqequations	sum (direct (p.e)) = 0;	equal (collect (p.f));	flow = first (p.f);implementation_end;   R 264 344    description '<Information> <Description>    <Version>4.2</Version><IsMainModel>1</IsMainModel>  <KeepParameterValues>False</KeepParameterValues>    <LibraryPath>Bond Graph\R.emx</LibraryPath>  <TimeStamp>2011-11-29 16:35:37</TimeStamp></Description></Information>';    type R     ports      power in p;    end;    icon bg ellipse bottom     figures      text 'R' 264 344 color 0 18 bold;    end;    implementation eqparameters	real oneup b_w;equations	p.e = b_w * p.f;implementation_end;   R1 560 208    description '<Information> <Description>    <Version>4.2</Version><IsMainModel>1</IsMainModel>  <KeepParameterValues>False</KeepParameterValues>    <LibraryPath>Bond Graph\R.emx</LibraryPath>  <TimeStamp>2011-11-29 16:35:37</TimeStamp></Description></Information>';    type R     ports      power in p;    end;    icon bg ellipse bottom     figures      text 'R' 560 208 color 0 18 bold;    end;    implementation eqparameters	real oneup b_f_pos;	real oneup b_f_neg;variables	real b_f_mean;	real b_f_off;equations	b_f_mean = (b_f_pos - b_f_neg) / 2;	b_f_off = b_f_pos + b_f_neg;	p.e = b_f_mean * 2 / 3.14159 * arctan(p.f) + b_f_off;implementation_end;   TF 360 280    description '<Information> <Description>    <Version>4.2</Version><IsMainModel>1</IsMainModel>  <KeepParameterValues>False</KeepParameterValues>    <LibraryPath>Bond Graph\TF.emx</LibraryPath>  <TimeStamp>2011-11-29 16:43:47</TimeStamp></Description></Information>';    type TF     ports      power in p1;      power out p2;     restrictions      causality constraint not_equal p1 p2;    end;    icon bg ellipse bottom     figures      text 'TF' 360 280 color 0 18 bold;    end;    implementation eqparameters	real oneup N;equations	p1.e = N * p2.e;	p2.f = N * p1.f;implementation_end;   ZeroJunction 480 280    description '<Information> <Description>    <Version>4.2</Version><IsMainModel>1</IsMainModel>  <KeepParameterValues>False</KeepParameterValues>    <LibraryPath>Bond Graph\ZeroJunction.emx</LibraryPath>  <TimeStamp>2011-11-29 16:45:16</TimeStamp></Description></Information>';    knot ZeroJunction     ports      power knot duplicatable none p [1];      signal knot out effort [1];     restrictions      causality constraint one_in p;    end;    icon bg ellipse     figures      text '0' 480 280 color 0 18 bold;    end;    implementation eqequations	sum (direct (p.f)) = 0;	equal (collect (p.e));	effort = first (p.e);implementation_end;  end;  connections   motor => OneJunction\p;   OneJunction\p => I\p;   OneJunction\p => TF\p1;   OneJunction1\p => C\p;   OneJunction1\p => R1\p;   R\p <= OneJunction\p;   TF\p2 => ZeroJunction\p;   ZeroJunction\p => harmonic_drive;   ZeroJunction\p => OneJunction1\p;  end; implementation_end;]]>  </Sidops>
 </Model>
</Document>
